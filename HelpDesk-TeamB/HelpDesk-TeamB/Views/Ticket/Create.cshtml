@model Ticket
@{ ViewData["Title"] = "Yeni müraciət"; }
<h2>Yeni müraciət</h2>
<form asp-action="Create" method="post" class="col-md-8">
  <div asp-validation-summary="ModelOnly" class="text-danger"></div>
  <div class="mb-3"><label asp-for="Title" class="form-label">Başlıq</label><input asp-for="Title" class="form-control" maxlength="120" /><span asp-validation-for="Title" class="text-danger"></span></div>
  <div class="mb-3"><label asp-for="Description" class="form-label">Təsvir</label><textarea asp-for="Description" rows="5" class="form-control" maxlength="2000"></textarea><div class="form-text"><span id="cnt">0</span>/2000</div><span asp-validation-for="Description" class="text-danger"></span></div>
  <div class="row"><div class="col-md-6 mb-3"><label asp-for="Category" class="form-label">Kateqoriya</label><select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<Category>()"></select></div>
  <div class="col-md-6 mb-3"><label asp-for="Priority" class="form-label">Prioritet</label><select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<Priority>()"></select></div></div>
  <button class="btn btn-primary">Göndər</button> <a class="btn btn-link" asp-action="Index">Ləğv et</a>
</form>
