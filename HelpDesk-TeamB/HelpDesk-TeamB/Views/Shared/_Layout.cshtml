<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - IT Help Desk</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-md navbar-dark bg-primary mb-4"><div class="container">
  <a class="navbar-brand" asp-controller="Home" asp-action="Index">IT Help Desk</a>
  <ul class="navbar-nav me-auto">
    <li class="nav-item"><a class="nav-link" asp-controller="Ticket" asp-action="Index">Müraciətlər</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Ticket" asp-action="Create">Yeni müraciət</a></li>
  </ul>
  <div class="d-flex align-items-center text-white">
  @if (User.Identity?.IsAuthenticated == true) {
    <span class="me-3">@User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
    <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Çıxış</button></form>
  } else {
    <a class="btn btn-outline-light btn-sm me-2" asp-controller="Account" asp-action="Login">Giriş</a>
    <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Register">Qeydiyyat</a>
  }
  </div>
</div></nav>
<main class="container">@RenderBody()</main>
<footer class="container text-muted small mt-5 mb-3">IT Help Desk prototipi</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
